---
import "../styles/global.css";
import FooterLayout from "./Footer.astro";
import HeaderLayout from "./Header.astro";
const { title = "Local AI Chat" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>

<body class="h-screen flex flex-col min-h-0 bg-gray-700 text-white">
    <HeaderLayout />
    <slot />
    <FooterLayout/>
</body>
</html>